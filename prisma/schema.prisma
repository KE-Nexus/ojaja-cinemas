// OJAJA Cinemas — data model
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CUSTOMER
  TICKETER
  ACCOUNTANT
  SUPERVISOR
  TECHNICIAN
  AUDITOR
  DRIVER
  CIRCUIT_ADMIN
}

enum MovieStatus {
  NOW_SHOWING
  COMING_SOON
  ARCHIVED
}

enum StaffSessionStatus {
  OPEN
  CLOSED
}

enum SeatCategory {
  STANDARD
  PREMIUM
  RECLINER
  ACCESSIBLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum SpaceRequestStatus {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

enum ContactStatus {
  NEW
  RESPONDED
  ARCHIVED
}

enum NotificationType {
  EMAIL
  SMS
}

enum NotificationStatus {
  SENT
  FAILED
}

enum StockRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockReceiptStatus {
  PENDING
  APPROVED
}

enum StockTransferStatus {
  PENDING
  APPROVED
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VgdType {
  VOUCHER
  GIFT_CARD
  DISCOUNT
}

enum VgdStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

// ---------- Core ----------

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String
  pinHash        String?
  role           Role      @default(CUSTOMER)
  loyaltyPoints  Int       @default(0)
  branchId       String?
  staffNumber    String?   @unique
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch         Branch?     @relation(fields: [branchId], references: [id])
  bookings       Booking[]   @relation("BookingCustomer")
  processedBookings Booking[] @relation("BookingProcessedBy")
  reviews        Review[]
  auditLogs      AuditLog[]
  rosterShifts   RosterShift[]
  staffSessions       StaffSession[] @relation("StaffSessionStaff")
  closedStaffSessions StaffSession[] @relation("StaffSessionClosedBy")

  stockRequestsRequested   StockRequest[]         @relation("StockRequestRequestedBy")
  stockRequestsApproved    StockRequest[]         @relation("StockRequestApprovedBy")
  stockReceiptsReceived    StockReceipt[]         @relation("StockReceiptReceivedBy")
  stockReceiptsApproved    StockReceipt[]         @relation("StockReceiptApprovedBy")
  stockTransfersInitiated  StockTransferReceipt[] @relation("StockTransferInitiatedBy")
  stockTransfersApproved   StockTransferReceipt[] @relation("StockTransferApprovedBy")
  purchaseOrdersCreated    PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved   PurchaseOrder[]        @relation("PurchaseOrderApprovedBy")
  vgdIssued                VgdRecord[]            @relation("VgdIssuedBy")
  vgdRedeemed              VgdRecord[]            @relation("VgdRedeemedBy")
  loyaltyAdjustmentsReceived LoyaltyAdjustment[]   @relation("LoyaltyAdjustmentUser")
  loyaltyAdjustmentsMade     LoyaltyAdjustment[]   @relation("LoyaltyAdjustmentStaff")
  loyaltyRedemptionsReceived LoyaltyRedemption[]   @relation("LoyaltyRedemptionUser")
  loyaltyRedemptionsProcessed LoyaltyRedemption[]  @relation("LoyaltyRedemptionStaff")
  seatClassSubscriptions  SeatClassSubscription[]

  @@index([branchId])
}

model Branch {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  address       String
  city          String
  phone         String
  openingHours  String
  lat           Float?
  lng           Float?
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  createdAt     DateTime      @default(now())

  auditoriums    Auditorium[]
  filmContracts  FilmContract[]
  ticketClasses  TicketClass[]
  posItems       PosItem[]
  staff          User[]
  rosterShifts   RosterShift[]
  staffSessions  StaffSession[]

  stockRequests       StockRequest[]
  stockReceipts       StockReceipt[]
  stockTransfersFrom  StockTransferReceipt[] @relation("StockTransferFromBranch")
  stockTransfersTo    StockTransferReceipt[] @relation("StockTransferToBranch")
  purchaseOrders      PurchaseOrder[]
  vgdRecords          VgdRecord[]
}

model Auditorium {
  id          String       @id @default(cuid())
  branchId    String
  name        String
  screenType  String       @default("Standard")
  rows        Int
  seatsPerRow Int

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  seats       Seat[]
  showtimes   Showtime[]

  @@index([branchId])
}

model Seat {
  id           String       @id @default(cuid())
  auditoriumId String
  row          String
  number       Int
  category     SeatCategory @default(STANDARD)

  auditorium   Auditorium   @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]
  seatLocks    SeatLock[]

  @@unique([auditoriumId, row, number])
  @@index([auditoriumId])
}

model Movie {
  id             String      @id @default(cuid())
  tmdbId         Int?        @unique
  title          String
  slug           String      @unique
  synopsis       String
  posterUrl      String
  backdropUrl    String?
  trailerUrl     String?
  genres         String
  classification String
  language       String
  runtimeMins    Int
  cast           String
  director       String?
  distributor    String?
  releaseDate    DateTime
  status         MovieStatus @default(COMING_SOON)
  createdAt      DateTime    @default(now())

  showtimes      Showtime[]
  reviews        Review[]
  filmContracts  FilmContract[]
}

model Showtime {
  id           String     @id @default(cuid())
  movieId      String
  auditoriumId String
  startTime    DateTime
  basePrice    Float
  language     String
  format       String     @default("2D")

  movie        Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  auditorium   Auditorium @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  seatLocks    SeatLock[]

  @@index([movieId])
  @@index([auditoriumId])
  @@index([startTime])
}

model SeatLock {
  id          String   @id @default(cuid())
  seatId      String
  showtimeId  String
  sessionId   String
  lockedUntil DateTime

  seat        Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  showtime    Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@unique([seatId, showtimeId])
  @@index([sessionId])
}

model Booking {
  id            String     @id @default(cuid())
  reference     String     @unique
  userId        String?
  processedById String?
  guestName     String?
  guestEmail    String?
  guestPhone    String?
  showtimeId    String
  status        BookingStatus @default(PENDING)
  subtotal      Float
  discount      Float      @default(0)
  totalAmount   Float
  promoCodeId   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User?      @relation("BookingCustomer", fields: [userId], references: [id])
  processedBy   User?      @relation("BookingProcessedBy", fields: [processedById], references: [id])
  showtime      Showtime   @relation(fields: [showtimeId], references: [id])
  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id])
  seats         BookingSeat[]
  concessions   BookingConcession[]
  payments      Payment[]

  @@index([userId])
  @@index([processedById])
  @@index([showtimeId])
}

model BookingSeat {
  id             String  @id @default(cuid())
  bookingId      String
  seatId         String
  priceAtBooking Float

  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat           Seat    @relation(fields: [seatId], references: [id])

  @@unique([bookingId, seatId])
  @@index([seatId])
}

model BookingConcession {
  id             String   @id @default(cuid())
  bookingId      String
  posItemId      String
  quantity       Int
  priceAtBooking Float

  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  posItem        PosItem  @relation(fields: [posItemId], references: [id])

  @@index([bookingId])
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  provider     String
  method       String
  status       PaymentStatus @default(PENDING)
  amount       Float
  reference    String        @unique
  rawResponse  String?
  createdAt    DateTime      @default(now())

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Review {
  id        String       @id @default(cuid())
  movieId   String
  userId    String
  rating    Int
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  movie     Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])

  @@index([movieId])
  @@index([userId])
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)

  bookings      Booking[]
}

model SpaceBookingRequest {
  id         String              @id @default(cuid())
  name       String
  email      String
  phone      String
  eventType  String
  eventDate  DateTime
  headcount  Int
  message    String?
  status     SpaceRequestStatus  @default(NEW)
  createdAt  DateTime            @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model NotificationOutbox {
  id        String              @id @default(cuid())
  type      NotificationType
  to        String
  subject   String
  body      String
  status    NotificationStatus  @default(SENT)
  createdAt DateTime            @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  metadata     String?
  createdAt    DateTime @default(now())

  actor        User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
}

model FilmContract {
  id                String   @id @default(cuid())
  branchId          String
  movieId           String
  contractStartDate DateTime
  createdAt         DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([movieId])
}

model TicketClass {
  id           String   @id @default(cuid())
  branchId     String
  description  String
  className    String
  type         String
  defaultPrice Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

// branchId null = a Head Office item in the shared master catalog ("HO Items");
// branchId set = a per-location item ("All Items").
model PosItem {
  id           String   @id @default(cuid())
  branchId     String?
  name         String
  description  String?
  itemClass    String
  itemGroup    String
  defaultPrice Float
  stockOnHand  Int      @default(0)
  createdAt    DateTime @default(now())

  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookingConcessions BookingConcession[]
  stockRequestLines  StockRequestLine[]
  stockReceiptLines  StockReceiptLine[]
  stockTransferLines StockTransferLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@index([branchId])
}

model RosterShift {
  id        String   @id @default(cuid())
  staffId   String
  branchId  String
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  staff  User   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([branchId, date])
}

// Expected Card/Cash/Transfer/Voucher totals are computed from Payment records tied
// to bookings this staff member processed while the session was open (not stored) —
// only the Actual (physically counted) amounts, entered at close-out, are persisted.
model StaffSession {
  id             String             @id @default(cuid())
  staffId        String
  branchId       String
  status         StaffSessionStatus @default(OPEN)
  actualCard     Float?
  actualCash     Float?
  actualTransfer Float?
  actualVoucher  Float?
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  closedById     String?

  staff    User  @relation("StaffSessionStaff", fields: [staffId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  closedBy User? @relation("StaffSessionClosedBy", fields: [closedById], references: [id])

  @@index([branchId])
  @@index([staffId])
}

// A fixed catalog of grantable permissions ("Is Circuit Staff", "Can Refund On POS", ...).
// CircuitAdmin can grant/revoke a claim's presence on a Role via RoleClaim — the actual
// permission check (requireClaim) treats CircuitAdmin as always-granted regardless of
// what's toggled here, so misconfiguring claims can never lock the admin out.
model Claim {
  id        String      @id @default(cuid())
  key       String      @unique
  label     String
  createdAt DateTime    @default(now())

  roleClaims RoleClaim[]
}

model RoleClaim {
  id        String   @id @default(cuid())
  role      Role
  claimId   String
  createdAt DateTime @default(now())

  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([role, claimId])
  @@index([role])
}

// ---------- Stock & Procurement ----------
// A branch requests more stock of specific items from HO; approving a request is an
// authorization step only — the actual stock-on-hand only changes when a Stock Receipt
// (goods physically arrived) or Stock Transfer (moved from another branch) is approved.

model StockRequest {
  id            String             @id @default(cuid())
  branchId      String
  status        StockRequestStatus @default(PENDING)
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  note          String?
  createdAt     DateTime           @default(now())

  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedBy User               @relation("StockRequestRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?              @relation("StockRequestApprovedBy", fields: [approvedById], references: [id])
  lines       StockRequestLine[]
  receipts    StockReceipt[]

  @@index([branchId])
}

model StockRequestLine {
  id             String @id @default(cuid())
  stockRequestId String
  posItemId      String
  quantity       Int

  stockRequest StockRequest @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  posItem      PosItem      @relation(fields: [posItemId], references: [id])
}

model StockReceipt {
  id             String             @id @default(cuid())
  branchId       String
  stockRequestId String?
  status         StockReceiptStatus @default(PENDING)
  receivedById   String
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockRequest StockRequest?      @relation(fields: [stockRequestId], references: [id])
  receivedBy   User               @relation("StockReceiptReceivedBy", fields: [receivedById], references: [id])
  approvedBy   User?              @relation("StockReceiptApprovedBy", fields: [approvedById], references: [id])
  lines        StockReceiptLine[]

  @@index([branchId])
}

model StockReceiptLine {
  id             String @id @default(cuid())
  stockReceiptId String
  posItemId      String
  quantity       Int

  stockReceipt StockReceipt @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  posItem      PosItem      @relation(fields: [posItemId], references: [id])
}

model StockTransferReceipt {
  id            String              @id @default(cuid())
  fromBranchId  String
  toBranchId    String
  status        StockTransferStatus @default(PENDING)
  initiatedById String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())

  fromBranch  Branch              @relation("StockTransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch    Branch              @relation("StockTransferToBranch", fields: [toBranchId], references: [id])
  initiatedBy User                @relation("StockTransferInitiatedBy", fields: [initiatedById], references: [id])
  approvedBy  User?               @relation("StockTransferApprovedBy", fields: [approvedById], references: [id])
  lines       StockTransferLine[]
}

model StockTransferLine {
  id                     String @id @default(cuid())
  stockTransferReceiptId String
  posItemId              String // the source (fromBranch) item being moved
  quantity               Int

  stockTransferReceipt StockTransferReceipt @relation(fields: [stockTransferReceiptId], references: [id], onDelete: Cascade)
  posItem              PosItem              @relation(fields: [posItemId], references: [id])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  branchId     String
  supplierName String
  status       PurchaseOrderStatus @default(PENDING)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy  User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  approvedBy User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  lines      PurchaseOrderLine[]

  @@index([branchId])
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  posItemId       String
  quantity        Int
  unitCost        Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  posItem       PosItem       @relation(fields: [posItemId], references: [id])
}

// ---------- Vouchers, Gifts & Discounts (VGD) ----------
// Distinct from PromoCode (customer-facing, self-service codes at checkout) — these are
// staff-issued goodwill vouchers, gift cards, or one-off discounts handed out in person.

model VgdRecord {
  id            String    @id @default(cuid())
  type          VgdType
  code          String    @unique
  value         Float
  isPercent     Boolean   @default(false)
  branchId      String?
  issuedById    String
  redeemedById  String?
  redeemedAt    DateTime?
  status        VgdStatus @default(ACTIVE)
  recipientName String?
  note          String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  branch     Branch? @relation(fields: [branchId], references: [id])
  issuedBy   User    @relation("VgdIssuedBy", fields: [issuedById], references: [id])
  redeemedBy User?   @relation("VgdRedeemedBy", fields: [redeemedById], references: [id])

  @@index([branchId])
}

// ---------- Loyalty ----------

model LoyaltyTier {
  id        String   @id @default(cuid())
  name      String   @unique
  minPoints Int
  perks     String?
  createdAt DateTime @default(now())
}

model LoyaltyReward {
  id          String   @id @default(cuid())
  name        String
  pointsCost  Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions LoyaltyRedemption[]
}

model LoyaltyRedemption {
  id           String   @id @default(cuid())
  userId       String
  rewardId     String
  pointsSpent  Int
  redeemedById String
  createdAt    DateTime @default(now())

  user       User          @relation("LoyaltyRedemptionUser", fields: [userId], references: [id])
  reward     LoyaltyReward @relation(fields: [rewardId], references: [id])
  redeemedBy User          @relation("LoyaltyRedemptionStaff", fields: [redeemedById], references: [id])

  @@index([userId])
}

model LoyaltyAdjustment {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  reason       String
  adjustedById String
  createdAt    DateTime @default(now())

  user       User @relation("LoyaltyAdjustmentUser", fields: [userId], references: [id])
  adjustedBy User @relation("LoyaltyAdjustmentStaff", fields: [adjustedById], references: [id])

  @@index([userId])
}

// ---------- Seat class notifications ----------

model SeatClassSubscription {
  id        String       @id @default(cuid())
  userId    String
  category  SeatCategory
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}
